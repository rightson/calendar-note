{
  "name": "calendar-note",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build && node scripts/package.mjs",
    "install:test-vault": "node scripts/install.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/multimonth": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/moment-timezone": "6.1.22",
    "ical.js": "2.2.1",
    "moment-timezone": "0.5.48",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
